# =============================================================================
# ElektraLog — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control!
#
# Port-Hinweis: Der externe Reverse-Proxy (nginx, Caddy o.ä.) auf dem
# Hostserver übernimmt SSL-Terminierung und Routing. Hier nur die
# Host-Ports eintragen, auf die der Proxy weiterleitet.
# =============================================================================

# ----------------------------------------------------------------------------
# Ports der Container (Host-seitig; der Reverse-Proxy leitet hierhin weiter)
# ----------------------------------------------------------------------------
APP_PORT=8888
SERVERPOD_PORT=8080
SUPERADMIN_PORT=8889
HOMEPAGE_PORT=8090
WIKI_PORT=3000

# ----------------------------------------------------------------------------
# Öffentliche URLs (werden in CORS, E-Mails, Links verwendet)
# Ohne abschließenden Slash!
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8888
BACKEND_URL=http://localhost:8080
SUPERADMIN_URL=http://localhost:8889

# ----------------------------------------------------------------------------
# PostgreSQL (nur lokal erreichbar — kein externer Zugriff nötig)
# POSTGRES_PORT     = interner Container-Port (für Serverpod-Verbindung, immer 5432)
# POSTGRES_HOST_PORT = Host-seitiger Port (anpassen wenn 5432 bereits belegt ist)
# ----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_USER=elektralog
POSTGRES_PASSWORD=changeme
POSTGRES_DB=elektralog
WIKIJS_DB=wikijs

# ----------------------------------------------------------------------------
# JWT (min. 32 Zeichen, zufällig generieren: openssl rand -hex 32)
# ----------------------------------------------------------------------------
JWT_SECRET=changeme_jwt_secret_min32chars

# ----------------------------------------------------------------------------
# SuperAdmin-Seed (wird beim ersten Serverstart automatisch angelegt)
# Danach kann das Passwort geändert werden — die Vars bleiben für künftige
# Neuinstallationen erhalten. Leer lassen um kein Seed auszulösen.
# ----------------------------------------------------------------------------
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=changeme_superadmin

# ----------------------------------------------------------------------------
# Wiki.js (company-Profil)
# ----------------------------------------------------------------------------
WIKI_SECRET=changeme_wikisecret
